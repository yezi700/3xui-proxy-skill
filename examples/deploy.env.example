# ============================================================================
# 3x-ui 部署配置
#
# 用法：
#     cp examples/deploy.env.example deploy.env
#     $EDITOR deploy.env
#
# deploy.env 已被 .gitignore 忽略，不会被提交到仓库。
# ⚠️ 里面是明文凭据，不要提交、不要外传。
# ============================================================================

# ---------------------------------------------------------------- 1. VPS 连接
# 必填
VPS_HOST=1.2.3.4
VPS_PORT=22
VPS_USER=root

# 密码 与 密钥 二选一（都填则优先用密码）
VPS_PASS=your-root-password
# VPS_KEY=C:/Users/you/.ssh/id_ed25519

# ---------------------------------------------------------------- 2. 域名与地址
# 必须已经解析到 VPS_HOST（dig +short $DOMAIN 应返回 VPS_HOST）
DOMAIN=jp.example.com
SERVER_IP=1.2.3.4

# 节点名称前缀，会出现在分享链接的备注里
NODE_PREFIX=JP

# ---------------------------------------------------------------- 3. 面板
# 留空则安装脚本自动随机生成
PANEL_USER=admin
PANEL_PASS=
PANEL_PORT=46821
PANEL_PATH=

# 面板 API Token —— 安装脚本跑完会打印，回填到这里
# 也可在面板「设置 → 安全 → API Token」查看，或：
#   sqlite3 /etc/x-ui/x-ui.db "select value from settings where key='apiToken';"
API_TOKEN=

# ---------------------------------------------------------------- 4. 订阅
SUB_PORT=2096
SUB_PATH=
# 合并后的 subId；留空则由 merge_subscription.py 随机生成
MERGED_EMAIL=merged
MERGED_SUBID=

# ---------------------------------------------------------------- 5. 节点端口
REALITY_PORT=443
HY2_PORT=443
TUIC_PORT=8443
# Hysteria2 端口跳跃范围（服务端 iptables 格式，冒号）
HY2_HOP_RANGE=58888:60888
# ACME 证书签发用
ACME_PORT=80
# SSH 端口（写防火墙白名单用）
SSH_PORT=22

# 证书目录，留空则默认 /root/cert/$DOMAIN
CERT_DIR=

# ---------------------------------------------------------------- 6. REALITY 参数
# 回落目标：必须是真实存在、支持 TLS1.3 + HTTP/2 的境外站点
REALITY_DEST=www.apple.com:443
REALITY_SNI=www.apple.com

# 固定密钥对（可选）。
# 留空则由 deploy_nodes.py 在 VPS 上执行 `xray x25519` 自动生成。
# 迁移 / 复现同一套节点时才需要手工填。
REALITY_PRIV=
REALITY_PUB=
REALITY_SID=

# ---------------------------------------------------------------- 7. IPv6 处理
# 1 = 屏蔽 IPv6，代理出口强制走 IPv4（推荐）
# 0 = 保留 IPv6（此时分享链接与出口都可能走 IPv6）
#
# 背景：3x-ui 生成的 Xray 配置里 routing.domainStrategy = "AsIs"，
# 域名交给系统解析；系统若有可用 IPv6，glibc 会优先返回 AAAA，
# 于是出口 IP 变成 IPv6。详见 references/pitfalls.md §4.4。
DISABLE_IPV6=1
# 关 IPv6 前会先把 resolv.conf 换成这里的纯 IPv4 DNS
# （不换的话，原有的 IPv6 nameserver 会拖慢甚至中断解析）
DNS_SERVERS=8.8.8.8 8.8.4.4 1.1.1.1

# ---------------------------------------------------------------- 8. HTTP / SOCKS5（可选）
# 由 scripts/add_http_socks.py 使用。给浏览器插件、系统代理、curl/git/Docker
# 这类"要一个普通代理"的场景用；不是翻墙协议，所有客户端都能用。
#
# ⚠️ 两个必须记住的点：
#   1. 不要用 1080 / 1081 —— 多数机房（含日本）在上游直接封掉这些常用代理端口。
#      脚本内置黑名单会拒绝，换 2000-3000 或 7000-9000 段。
#   2. HTTP / SOCKS5 入站不会出现在订阅里（3x-ui 只为 vmess/vless/trojan/ss/tuic
#      生成链接，没有 genHttpLink / genSocksLink）。地址要单独发给用户。
#      详见 references/pitfalls.md §4.5 与 §6.6。
#
# ⚠️ 两者都是明文协议（HTTP/SOCKS5 不做传输加密），务必：
#   - 必须设置 PROXY_PASS，不要留空（脚本会拒绝空密码）
#   - 只给可信网络/固定 IP 用，或后续用 iptables 按来源 IP 限制接入口
WITH_HTTP=1
WITH_SOCKS=1
HTTP_PORT=8080
# SOCKS5 在 3x-ui 里的协议名是 mixed（用 socks 会被拒，见 pitfalls.md §6.5）
# mixed 的同一个端口同时兼容 HTTP CONNECT，所以两个端口都可用
SOCKS_PORT=2080
PROXY_USER=proxyuser
PROXY_PASS=

# ---------------------------------------------------------------- 9. 验证脚本用（可选）
# 留空则 verify_nodes.sh 自动从 /root/.xui-skill/node-credentials.json 读取
VERIFY_REALITY_UUID=
VERIFY_HY2_AUTH=
VERIFY_HY2_OBFS_PW=
VERIFY_TUIC_UUID=
VERIFY_TUIC_PASSWORD=
VERIFY_PROXY_USER=
VERIFY_PROXY_PASS=
