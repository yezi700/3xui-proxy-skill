# ============================================================================
# 3x-ui 部署配置
#
# 用法：
#     cp examples/deploy.env.example deploy.env
#     $EDITOR deploy.env
#
# deploy.env 已被 .gitignore 忽略，不会被提交到仓库。
# ⚠️ 里面是明文凭据，不要提交、不要外传。
# ============================================================================

# ---------------------------------------------------------------- 1. VPS 连接
# 必填
VPS_HOST=1.2.3.4
VPS_PORT=22
VPS_USER=root

# 密码 与 密钥 二选一（都填则优先用密码）
VPS_PASS=your-root-password
# VPS_KEY=C:/Users/you/.ssh/id_ed25519

# ---------------------------------------------------------------- 2. 域名与地址
# 新手先读 references/domain-and-dns.md；A 指向 VPS IPv4，Cloudflare 使用灰云
# 预检（替换实际参数）：python scripts/check_dns.py --domain jp.example.com --ipv4 1.2.3.4
# 默认 DISABLE_IPV6=1 时不应保留该节点的 AAAA 记录
DOMAIN=jp.example.com
SERVER_IP=1.2.3.4

# 节点名称前缀，会出现在分享链接的备注里
NODE_PREFIX=JP

# ---------------------------------------------------------------- 3. 面板
# 留空则安装脚本自动随机生成
PANEL_USER=admin
PANEL_PASS=
PANEL_PORT=46821
PANEL_PATH=

# 面板 API Token —— 安装脚本跑完会打印，回填到这里
# ⚠️ 3x-ui v3.9.0 的 api_tokens 表只存 SHA-256，sqlite3 直接读 settings 表拿不到。
#    正确姿势见 references/xui-api.md §1.1，或直接在面板「设置 → 安全 → API Token」新建。
API_TOKEN=

# ---------------------------------------------------------------- 4. 订阅
SUB_PORT=2096
SUB_PATH=
# 合并后的 subId；留空则由 merge_subscription.py 随机生成
MERGED_EMAIL=merged
MERGED_SUBID=

# ---------------------------------------------------------------- 5. 节点端口
REALITY_PORT=443
HY2_PORT=443
TUIC_PORT=8443
# Hysteria2 端口跳跃范围（服务端 iptables 格式，冒号）
HY2_HOP_RANGE=58888:60888
# ACME 证书签发用
ACME_PORT=80
# SSH 端口（写防火墙白名单用）
SSH_PORT=22

# 证书目录，留空则默认 /root/cert/$DOMAIN
CERT_DIR=

# ---------------------------------------------------------------- 6. REALITY 参数
# 回落目标：必须是真实存在、支持 TLS1.3 + HTTP/2 的境外站点
REALITY_DEST=www.apple.com:443
REALITY_SNI=www.apple.com

# 固定密钥对（可选）。
# 留空则由 deploy_nodes.py 在 VPS 上执行 `xray x25519` 自动生成。
# 迁移 / 复现同一套节点时才需要手工填。
REALITY_PRIV=
REALITY_PUB=
REALITY_SID=

# ---------------------------------------------------------------- 7. IPv6 处理
# 1 = 屏蔽 IPv6，代理出口强制走 IPv4（推荐）
# 0 = 保留 IPv6（此时分享链接与出口都可能走 IPv6）
#
# 背景：3x-ui 生成的 Xray 配置里 routing.domainStrategy = "AsIs"，
# 域名交给系统解析；系统若有可用 IPv6，glibc 会优先返回 AAAA，
# 于是出口 IP 变成 IPv6。详见 references/pitfalls.md §4.4。
DISABLE_IPV6=1
# 关 IPv6 前会先把 resolv.conf 换成这里的纯 IPv4 DNS
# （不换的话，原有的 IPv6 nameserver 会拖慢甚至中断解析）
DNS_SERVERS=8.8.8.8 8.8.4.4 1.1.1.1

# ---------------------------------------------------------------- 8. 验证脚本用（可选）
# 留空则 verify_nodes.sh 自动从 /root/.xui-skill/node-credentials.json 读取
VERIFY_REALITY_UUID=
VERIFY_HY2_AUTH=
VERIFY_HY2_OBFS_PW=
VERIFY_TUIC_UUID=
VERIFY_TUIC_PASSWORD=
